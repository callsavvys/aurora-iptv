{
  "name": "aurora-iptv-mac",
  "version": "0.34.0",
  "description": "Local-first IPTV player for macOS",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package:mac": "bash scripts/build-mac.sh",
    "test": "electron tests/local-sync.cjs && electron tests/signed-in.cjs && electron tests/tv-nav.cjs && electron tests/together.cjs && electron tests/cliffhanger.cjs && node tests/update-notice.cjs && node tests/tv-scale.cjs",
    "test:party": "electron tests/party-live.cjs",
    "test:sync": "bash tests/two-devices.sh",
    "test:updater": "electron tests/updater-app",
    "test:signed-in": "electron tests/signed-in.cjs",
    "package:tv": "bash mobile/scripts/build-android.sh"
  },
  "dependencies": {
    "hls.js": "^1.6.13"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.0",
    "electron": "^37.6.0"
  },
  "updates": {
    "repository": "callsavvys/aurora-iptv",
    "asset": "Aurora-IPTV-Mac-Apple-Silicon.zip"
  }
}
